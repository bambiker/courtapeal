{
  "base_url": "https://supremedecisions.court.gov.il/",
  "date_format": "jerusalem_midnight_utc",
  "to_offset_days": 1,
  "delay_seconds": 2.0,
  "record_id_keys": ["Id"],
  "case_desc_field": "CaseDesc",
  "doc_type_field": "Type",
  "case_types": ["ע\"א", "ע\"פ", "עע\"מ", "רע\"א", "רע\"פ", "בר\"ם", "עש\"מ", "ע\"ב", "רע\"ב", "רע\"מ"],
  "only_final_judgments": true,
  "final_judgment_markers": ["פסק"],
  "result_cap_warning": 1000,
  "download_url_templates": [
    "https://supremedecisions.court.gov.il/Home/Download?path={Path}&fileName={FileName}&type=2",
    "https://supremedecisions.court.gov.il/Home/Download?path={Path}&fileName={FileName}&type=4",
    "https://supremedecisions.court.gov.il/Home/Download?path={Path}&fileName={DocName}&type=2",
    "https://supremedecisions.court.gov.il/Home/Download?path={PathForWeb}&fileName={FileName}&type=2",
    "https://supremedecisions.court.gov.il/{PathForWeb}/{DocName}"
  ],
  "_notes": "date_format/מבנה הבקשה אומתו מול האתר (11/2026). download_url_templates עדיין ניחוש: התבנית הראשונה שעובדת עוברת אוטומטית לראש הרשימה."
}
