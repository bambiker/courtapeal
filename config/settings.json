{
  "base_url": "https://supremedecisions.court.gov.il/",
  "date_format": "%Y-%m-%d",
  "delay_seconds": 2.0,
  "record_id_keys": ["CaseNum", "FileName"],
  "download_url_template": "https://supremedecisions.court.gov.il/Home/Download?path={Path}&fileName={FileName}&type=4",
  "case_type_prefixes": ["ע\"א", "ע\"פ", "עע\"מ", "רע\"א", "רע\"פ", "בר\"ם", "עש\"מ", "ע\"ב", "רע\"ב", "רע\"מ"],
  "only_final_judgments": false,
  "final_judgment_markers": ["פסק-דין", "פסק דין"],
  "result_cap_warning": 1000,
  "_notes": "record_id_keys, download_url_template ו-date_format הם ניחוש ראשוני - יש לאמת מול sample_record שבתבנית אחרי discover."
}
